// libubifocus.so and libdualcameraddm.so DT_NEED the literal soname
// "libstdc++.so", which has no vendor-image Soong variant (only the core
// "libstdc++" and the differently-sonamed "libstdc++_vendor" exist) — no
// module can be listed in shared_libs that would actually satisfy
// check_elf_files here, so it's disabled for just these two, same as
// cacaoserver above. This isn't a regression: raw PRODUCT_COPY_FILES never
// checked this dependency either, so on-device resolution is unchanged.

cc_prebuilt_library_shared {
    name: "libubifocus",
    owner: "sony",
    strip: {
        none: true,
    },
    target: {
        android_arm: {
            srcs: ["proprietary/system/vendor/lib/libubifocus.so"],
            shared_libs: [
                "liblog",
                "libdl",
                "libz",
                "libc",
                "libm",
            ],
        },
    },
    compile_multilib: "32",
    prefer: true,
    soc_specific: true,
    check_elf_files: false,
}

cc_prebuilt_library_shared {
    name: "libdualcameraddm",
    owner: "sony",
    strip: {
        none: true,
