soong_namespace {
    imports: [
        "vendor/sony/yoshino-common",
    ],
}

android_app_import {
    name: "SomcMovieCreator-release",
    owner: "sony",
    apk: "proprietary/system/priv-app/SomcMovieCreator-release/SomcMovieCreator-release.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
}

