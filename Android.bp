// cacaoserver itself has no available source (only the libcacao_* libs it
// loads were reconstructed, see cacao/); ships as-is, same blob as stock.
// init_rc pulls in proprietary/system/etc/init/cacaoserver.rc automatically.
cc_prebuilt_binary {
    name: "cacaoserver",
    owner: "sony",
    srcs: ["proprietary/system/bin/cacaoserver"],
    compile_multilib: "32",
    // System (default): must stay system-side so it links system libbinder
    // (defaults to /dev/binder) and its registered "cacao" service is
    // reachable via the app-facing service_manager SemcCameraUI looks in.
    // Confirmed on-device: as vendor:true it linked vendor libbinder,
    // defaulted to /dev/vndbinder/vndservicemanager instead, and the app
    // could never find the service at all (ServiceManagerCppClient timed
    // out waiting on /dev/binder while cacaoserver had registered on
    // vndservicemanager). See libcacao_service/Android.bp for how the
    // vendor-only HIDL dependency is handled instead.
    strip: {
        none: true,
    },
    check_elf_files: false,
    init_rc: ["proprietary/system/etc/init/cacaoserver.rc"],
}

// ─── vendor/lib camera vision libs (SCVE/ubifocus/dualcameraddm) ───
// Converted from PRODUCT_COPY_FILES to real prebuilt modules so
// check-elf-prebuilt-product-copy-files can run on this tree (see the note
// in BoardConfigVendor.mk). shared_libs below come from `readelf -d` on the
// shipped blobs; the upstream libs they resolve to (libfastcvopt,
// libmmcamera_faceproc[2], libadsprpc, libOpenCL) are already Soong modules
// in vendor/sony/yoshino-common, imported via the soong_namespace above.

cc_prebuilt_library_shared {
    name: "libscveCommon_stub",
    owner: "sony",
    strip: {
        none: true,
    },
    target: {
        android_arm: {
            srcs: ["proprietary/system/vendor/lib/libscveCommon_stub.so"],
            shared_libs: [
                "libadsprpc",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "32",
    prefer: true,
    soc_specific: true,
}

cc_prebuilt_library_shared {
    name: "libscveCommon",
    owner: "sony",
    strip: {
        none: true,
    },
    target: {
        android_arm: {
            srcs: ["proprietary/system/vendor/lib/libscveCommon.so"],
            shared_libs: [
                "liblog",
                "libion",
                "libscveCommon_stub",
                "libadsprpc",
                "libc++",
                "libc",
                "libm",
                "libdl",
