cc_prebuilt_binary {
    name: "cacaoserver",
    owner: "sony",
    srcs: ["proprietary/system/bin/cacaoserver"],
    compile_multilib: "32",

    strip: {
        none: true,
    },
    check_elf_files: false,
    init_rc: ["proprietary/system/etc/init/cacaoserver.rc"],
}

cc_prebuilt_library_shared {
    name: "libscveCommon_stub",
    owner: "sony",
    strip: {
        none: true,
    },
    target: {
        android_arm: {
            srcs: ["proprietary/system/vendor/lib/libscveCommon_stub.so"],
            shared_libs: [
                "libadsprpc",
                "libc++",
                "libc",
                "libm",
                "libdl",
            ],
        },
    },
    compile_multilib: "32",
    prefer: true,
    soc_specific: true,
}

