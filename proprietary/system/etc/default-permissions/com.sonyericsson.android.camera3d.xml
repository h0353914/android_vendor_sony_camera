<exceptions>
  <exception package="com.sonyericsson.android.camera3d">
    <!-- whitelisted="true" forces this grant to override a prior
         USER_SET/FIXED state (see DefaultPermissionGrantPolicy
         .grantRuntimePermissions()'s isFixedOrUserSet() check), needed
         because early manual testing on dev devices already left a
         USER_SET record for this permission before this file existed. -->
    <permission name="android.permission.CAMERA" whitelisted="true"/>
    <permission name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    <permission name="android.permission.READ_EXTERNAL_STORAGE"/>
    <permission name="android.permission.ACCESS_FINE_LOCATION"/>
    <permission name="android.permission.ACCESS_COARSE_LOCATION"/>
  </exception>
</exceptions>
